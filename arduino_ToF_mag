#include <Wire.h>
#include "Adafruit_VL6180X.h"

// --- Konfiguration ---
Adafruit_VL6180X vl = Adafruit_VL6180X();

// --- Statistische Variablen ---
unsigned long lastReportTime = 0; 
uint8_t minDist = 255;
uint8_t maxDist = 0;
unsigned long distSum = 0;
int sampleCount = 0;
float latestAverage = 0.0;


// Funktion um ermittelte Werte im seriellen Monitor auszugeben
